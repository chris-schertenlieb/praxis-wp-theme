{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "praxis/callout",
	"version": "0.2.0",
	"title": "Callout",
	"category": "praxis",
	"icon": "megaphone",
	"description": "Draw attention to a note, tip, warning or success message.",
	"keywords": [
		"note",
		"tip",
		"warning",
		"success",
		"notice",
		"alert",
		"admonition"
	],
	"textdomain": "praxis",
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"shadow": true
	},
	"attributes": {
		"type": {
			"type": "string",
			"enum": [ "note", "tip", "warning", "success" ],
			"default": "note"
		}
	},
	"example": {
		"attributes": {
			"type": "tip"
		},
		"innerBlocks": [
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "Every color here comes from the palette, so switching style variations recolors this callout too."
				}
			}
		]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
