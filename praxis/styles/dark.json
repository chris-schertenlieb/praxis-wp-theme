{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Dark",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#071a1a" },
				{ "slug": "surface", "name": "Surface", "color": "#0d2626" },
				{ "slug": "secondary", "name": "Secondary", "color": "#143434" },
				{ "slug": "border", "name": "Border", "color": "#2a4a48" },
				{ "slug": "muted", "name": "Muted", "color": "#9fb5b2" },
				{ "slug": "contrast", "name": "Contrast", "color": "#e8f1ef" },
				{ "slug": "primary", "name": "Primary", "color": "#7fd8c9" },
				{ "slug": "accent", "name": "Accent", "color": "#bef264" }
			]
		},
		"shadow": {
			"presets": [
				{ "slug": "sm", "name": "Small", "shadow": "0 1px 2px rgba(0, 0, 0, 0.3), 0 1px 3px rgba(0, 0, 0, 0.4)" },
				{ "slug": "md", "name": "Medium", "shadow": "0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -2px rgba(0, 0, 0, 0.4)" },
				{ "slug": "lg", "name": "Large", "shadow": "0 12px 24px -6px rgba(0, 0, 0, 0.5), 0 4px 8px -4px rgba(0, 0, 0, 0.4)" }
			]
		}
	}
}
