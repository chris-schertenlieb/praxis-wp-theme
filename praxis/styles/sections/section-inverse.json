{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"slug": "section-inverse",
	"title": "Inverse",
	"blockTypes": [ "core/group", "core/columns", "core/column", "core/cover" ],
	"styles": {
		"color": {
			"background": "var:preset|color|contrast",
			"text": "var:preset|color|base"
		},
		"elements": {
			"heading": {
				"color": { "text": "var:preset|color|base" }
			},
			"link": {
				"color": { "text": "var:preset|color|base" },
				":hover": {
					"color": { "text": "var:preset|color|accent" }
				},
				":focus-visible": {
					"outline": { "color": "var:preset|color|base" }
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|contrast"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|base",
						"text": "var:preset|color|contrast"
					}
				},
				":focus-visible": {
					"color": {
						"background": "var:preset|color|base",
						"text": "var:preset|color|contrast"
					},
					"outline": { "color": "var:preset|color|base" }
				}
			}
		},
		"blocks": {
			"core/site-tagline": {
				"color": { "text": "color-mix(in srgb, currentColor 72%, transparent)" }
			}
		}
	}
}
