	"styles": {
		"elements": {
			"heading": { "typography": { "fontWeight": "600", "letterSpacing": "-0.01em" } },
			"button": { "border": { "radius": "var:preset|border-radius|full" } }
		},
		"blocks": {
			"core/pullquote": { "typography": { "fontStyle": "italic", "fontWeight": "400", "letterSpacing": "0" } },
			"core/quote": { "border": { "left": { "color": "var:preset|color|primary" } } }
		}
