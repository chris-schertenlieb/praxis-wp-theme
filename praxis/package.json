{
	"name": "praxis",
	"version": "0.1.0",
	"private": true,
	"description": "Praxis block theme — custom blocks build.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build/blocks --blocks-manifest",
		"start": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build/blocks --blocks-manifest",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:js": "wp-scripts lint-js src",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"format": "wp-scripts format src"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.0.0"
	}
}
