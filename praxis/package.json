{
	"name": "praxis",
	"version": "0.1.0",
	"private": true,
	"description": "Praxis block theme — custom blocks build.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "npm run build:blocks && npm run build:js",
		"build:blocks": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build/blocks --blocks-manifest",
		"build:js": "wp-scripts build accent-control=./accent-control.js settings=./settings.js --webpack-src-dir=src/js --output-path=build/js",
		"start": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build/blocks --blocks-manifest",
		"start:js": "wp-scripts start accent-control=./accent-control.js settings=./settings.js --webpack-src-dir=src/js --output-path=build/js",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:js": "wp-scripts lint-js src",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\" \"assets/css/**/*.css\"",
		"format": "wp-scripts format src"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.0.0"
	},
	"dependencies": {
		"@wordpress/icons": "^18.0.0"
	}
}
