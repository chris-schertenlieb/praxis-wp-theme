{
	"name": "chris-schertenlieb/praxis-wp-theme",
	"description": "Praxis — an open source Gutenberg block theme and child theme.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"wp-cli/i18n-command": "^2.6"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"format": "phpcbf",
		"make-pot": "wp i18n make-pot praxis praxis/languages/praxis.pot --domain=praxis --exclude=node_modules,src --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/chris-schertenlieb/praxis-wp-theme/issues\"}'"
	}
}
